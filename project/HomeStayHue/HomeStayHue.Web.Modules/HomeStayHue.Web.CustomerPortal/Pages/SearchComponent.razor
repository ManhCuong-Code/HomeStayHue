@page "/"
@page "/products"
@page "/product"
@page "/rooms"
@page "/room"

@rendermode InteractiveServer

@inject ISearchProductUseCase searchProduct

<PageTitle>Danh Mục Phòng — Homestay Huế</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold text-success mb-1">🏡 Danh Mục Buồng Phòng — Homestay Huế</h3>
        <p class="text-muted small mb-0">Hệ thống đặt phòng trực tuyến Homestay Huế uy tín, tiện lợi và tiết kiệm.</p>
    </div>
    <span class="badge bg-success p-2">📅 Check-in 14:00 | Check-out 12:00</span>
</div>

<SearchBarComponent OnSearch="HandleSearch"></SearchBarComponent>
<br/>

@if (products != null && products.Any())
{
    <div class="d-flex flex-wrap">
        @foreach (var product in products)
        {
            <ProductCardComponent product="product"></ProductCardComponent>
        }
    </div>
}
else
{
    <div class="alert alert-light border text-muted">
        <em>Cannot find products.</em>
    </div>
}


@code {
    private IEnumerable<Product>? products;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        products = searchProduct.Execute();
    }
    private void HandleSearch(string filter)
    {
        products = searchProduct.Execute(filter);
    }
}
