@page "/admin"
@attribute [Authorize(Roles = "Admin,Administrator,Staff")]

<PageTitle>Quản Trị Hệ Thống - Admin Portal</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock-fill me-2 text-warning"></i>Phân Hệ Quản Trị & Kiểm Tra Dành Cho Nhân Viên
            </h2>
            <p class="text-muted mb-0">
                <AuthorizeView>
                    <Authorized>
                        <span class="badge bg-primary me-2"><i class="bi bi-person-badge me-1"></i>Nhân viên đang đăng nhập: <strong>@context.User.Identity?.Name</strong></span>
                        <span class="badge bg-secondary"><i class="bi bi-shield me-1"></i>Quyền hạn: Admin / Staff</span>
                    </Authorized>
                </AuthorizeView>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="products" class="btn btn-outline-secondary"><i class="bi bi-shop me-1"></i>Xem Cửa Hàng</a>
            <a href="/" class="btn btn-outline-success"><i class="bi bi-house me-1"></i>Trang Khách Đặt Phòng</a>
            <a href="/logout" class="btn btn-danger"><i class="bi bi-box-arrow-right me-1"></i>Đăng Xuất</a>
        </div>
    </div>

    <!-- Tabs điều hướng kiểm tra -->
    <ul class="nav nav-tabs nav-fill mb-3">
        <li class="nav-item">
            <button class="nav-link fw-bold py-3 @(selectedTab == "outstanding" ? "active text-primary border-primary border-bottom-0" : "text-muted")" 
                    @onclick='() => selectedTab = "outstanding"'>
                <i class="bi bi-clock-history me-2"></i>Đơn Đặt Phòng Chờ Xử Lý (Outstanding)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold py-3 @(selectedTab == "processed" ? "active text-success border-success border-bottom-0" : "text-muted")" 
                    @onclick='() => selectedTab = "processed"'>
                <i class="bi bi-check2-circle me-2"></i>Đơn Đặt Phòng Đã Xử Lý (Processed)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold py-3 @(selectedTab == "rooms" ? "active text-warning border-warning border-bottom-0" : "text-muted")" 
                    @onclick='() => selectedTab = "rooms"'>
                <i class="bi bi-door-open-fill me-2"></i>Kiểm Tra Tình Trạng Buồng Phòng (Room Status)
            </button>
        </li>
    </ul>

    <!-- Nội dung Tab -->
    @if (selectedTab == "outstanding")
    {
        <OutstandingOrdersComponent />
    }
    else if (selectedTab == "processed")
    {
        <ProcessedOrdersComponent />
    }
    else if (selectedTab == "rooms")
    {
        <HomeStayHue.Web.AdminPortal.Controls.RoomInspectionComponent />
    }
</div>

@code {
    private string selectedTab = "outstanding";
}