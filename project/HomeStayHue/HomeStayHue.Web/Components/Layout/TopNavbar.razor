@using Microsoft.AspNetCore.Components.Authorization

<nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3 shadow sticky-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-success d-flex align-items-center" href="/">
            <i class="bi bi-house-heart-fill me-2 fs-4"></i>
            <span>HomeStayHue</span>
        </a>

        <div class="d-flex align-items-center d-lg-none ms-auto me-2">
            <NavLink class="nav-link text-white me-2" href="/cart">
                <HomeStayHue.Web.CustomerPortal.Controls.CartComponent />
            </NavLink>
        </div>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <!-- Menu Khách Hàng (Tự do truy cập không cần đăng nhập) -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-compass me-1"></i>Trang Chủ
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="products">
                        <i class="bi bi-door-closed me-1"></i>Danh Sách Buồng Phòng
                    </NavLink>
                </li>
                <li class="nav-item ms-lg-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-2 small">
                        <i class="bi bi-shield-check me-1"></i>Khách Đặt Phòng Tự Do (Không Bắt Buộc Đăng Nhập)
                    </span>
                </li>
            </ul>

            <!-- Phân quyền người dùng & nhân viên -->
            <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                <li class="nav-item d-none d-lg-block">
                    <NavLink class="nav-link text-white" href="/cart">
                        <HomeStayHue.Web.CustomerPortal.Controls.CartComponent />
                    </NavLink>
                </li>

                <AuthorizeView>
                    <Authorized>
                        @if (context.User.IsInRole("Admin") || context.User.IsInRole("Staff") || context.User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" href="/admin">
                                    <i class="bi bi-speedometer2 me-1"></i>Kiểm Tra Đơn & Phòng (Admin)
                                </a>
                            </li>
                            <li class="nav-item text-light small d-none d-xl-inline">
                                <span class="badge bg-primary"><i class="bi bi-person-badge me-1"></i>@context.User.Identity?.Name</span>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item text-light small">
                                <span class="badge bg-info text-dark"><i class="bi bi-person me-1"></i>Khách: @context.User.Identity?.Name</span>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm" href="/logout">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng Xuất
                            </a>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" href="/login">
                                <i class="bi bi-person-check me-1"></i>Đăng Nhập Khách
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold text-dark shadow-sm" href="/login?role=staff">
                                <i class="bi bi-shield-lock-fill me-1"></i>Nhân Viên Đăng Nhập
                            </a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
